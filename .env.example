# Dominio publico que ya apunta a la IP del servidor (sin https://)
DOMAIN=seal.example.com

# Correo usado por Let's Encrypt para avisos de expiracion
CERTBOT_EMAIL=admin@example.com

# 1 usa el entorno de pruebas de Let's Encrypt; 0 solicita el certificado real
CERTBOT_STAGING=1

# Copia diaria del volumen de archivos; conserva siete días en ./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
