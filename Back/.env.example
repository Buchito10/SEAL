PORT=3001
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
TRUST_PROXY_HOPS=0

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
AUTH_COOKIE_NAME=seal_session
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost
API_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

FIREBASE_SERVICE_ACCOUNT=secrets/firebase-admin.json
FIREBASE_STORAGE_BUCKET=

FRONT_RESET_URL=http://localhost:3000/reset-password
FRONT_ACTIVATION_URL=http://localhost:3000/activar-cuenta
FRONT_SIGN_URL=http://localhost:3000/firma-movil
PASSWORD_TOKEN_EXPIRES_MIN=30
TOKEN_PEPPER=change-me
RETURN_RESET_TOKEN_IN_RESPONSE=false
INTERNAL_CRON_SECRET=

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
ADMIN_BOOTSTRAP_NAME=Admin Seed

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

MAX_DOCX_MB=15
EDIT_LOCK_TTL_MIN=20

ENABLE_LOCAL_DRAFT_CLEANUP=true
DRAFT_CLEANUP_CRON=10 3 * * *
TZ=America/Mexico_City

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_OUTPUT_TOKENS=2500
